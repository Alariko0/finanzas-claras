# FinanzasClaras - Server Environment Variables
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase (se usan a partir de la fase 1) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>
# Solo para scripts de administración. Nunca en peticiones normales.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Legado (se eliminan en la fase 1) ---
MONGODB_URI=mongodb://localhost:27017/finanzas-claras
JWT_SECRET=<genera-uno-con: openssl rand -hex 32>
