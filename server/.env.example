# FinanzasClaras - Server Environment Variables
# Copia este archivo a .env y rellénalo. .env está en .gitignore: nunca lo subas.
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase (Settings > API en el dashboard) ---
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<sb_publishable_...>

# Tras un proxy inverso/balanceador: nº de saltos de confianza (p. ej. 1)
# TRUST_PROXY=1
